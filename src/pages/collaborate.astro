---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Collaborate with us!';
---

<BaseLayout pageTitle={pageTitle}>
  <p class="lead text-muted mb-5">
    We welcome collaborations with academic researchers, clinicians, and industry partners who share
    our interest in mass spectrometry-based proteomics and metabolomics.
  </p>

  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 bg-body-secondary">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-mortarboard fs-2 text-primary"></i>
            <h2 class="h5 mb-0">Academic Collaborations</h2>
          </div>
          <p class="text-muted mb-0">
            We actively collaborate with research groups across computational biology and
            bioinformatics. Whether you are looking to apply our tools to your data or co-develop
            new methodology, we are happy to explore joint projects.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 bg-body-secondary">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-building fs-2 text-primary"></i>
            <h2 class="h5 mb-0">Industry Partnerships</h2>
          </div>
          <p class="text-muted mb-0">
            We partner with companies in the life sciences and instrument manufacturing space. We
            offer expertise in algorithm development, software engineering, and large-scale data
            analysis for proteomics and metabolomics workflows.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100 bg-body-secondary">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-hospital fs-2 text-primary"></i>
            <h2 class="h5 mb-0">Clinical Research</h2>
          </div>
          <p class="text-muted mb-0">
            We collaborate with hospital partners to apply computational approaches to solve
            real-world biomedical questions.
          </p>
        </div>
      </div>
    </div>
  </div>

  <section class="mb-5">
    <h2 class="h4 mb-3">What We Offer</h2>
    <ul class="list-unstyled d-flex flex-column gap-2">
      {
        [
          'Algorithm and software development for mass spectrometry data analysis',
          'Machine learning and deep learning expertise',
          'Large-scale data processing across public repositories',
          'Expertise in proteomics and metabolomics data',
          'Joint grant applications and co-supervision of students',
        ].map((item) => (
          <li class="d-flex align-items-start gap-2">
            <i class="bi bi-check2-circle text-primary mt-1 flex-shrink-0" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-5">
    <h2 class="h4 mb-3">How to Get in Touch</h2>
    <p class="text-muted mb-4">
      If you are interested in collaborating, please reach out by email with a brief description of
      your project and how you envision working together. We will get back to you as soon as
      possible.
    </p>
    <a href="/contact" class="btn btn-primary">
      <i class="bi bi-envelope me-2"></i>Contact Us
    </a>
  </section>
</BaseLayout>
